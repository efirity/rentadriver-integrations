{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-shipping" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }} <small>v{{ version }}</small></h1>
      <ol class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}</ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="card mb-3">
      <div class="card-body">
        {% if connected %}
          <p>{{ text_connected|format(store_key) }} {{ text_managed }}</p>
          <a href="{{ open }}" target="_blank" rel="noopener" class="btn btn-primary">{{ button_open }}</a>
          <a href="{{ setup }}" target="_blank" rel="noopener" class="btn btn-light">{{ button_setup }}</a>
          <a href="{{ disconnect }}" class="btn btn-link">{{ button_disconnect }}</a>
        {% else %}
          <p>{{ text_intro }}</p>
          {% if https %}<a href="{{ connect }}" class="btn btn-primary">{{ button_connect }}</a>{% else %}<div class="alert alert-warning">{{ text_no_https }}</div>{% endif %}
        {% endif %}
      </div>
    </div>
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
      <div class="card-body">
        <form id="form-shipping" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <div class="row mb-3">
            <label class="col-sm-3 col-form-label">{{ entry_status }}</label>
            <div class="col-sm-9"><div class="form-check form-switch form-switch-lg"><input type="hidden" name="shipping_rentadriver_status" value="0"/><input type="checkbox" name="shipping_rentadriver_status" value="1" id="input-status" class="form-check-input"{% if shipping_rentadriver_status %} checked{% endif %}/></div></div>
          </div>
          <div class="row mb-3">
            <label for="input-status-shipped" class="col-sm-3 col-form-label">{{ entry_status_shipped }}</label>
            <div class="col-sm-9"><select name="shipping_rentadriver_status_shipped" id="input-status-shipped" class="form-select"><option value="0">{{ text_keep }}</option>{% for s in order_statuses %}<option value="{{ s.order_status_id }}"{% if s.order_status_id == shipping_rentadriver_status_shipped %} selected{% endif %}>{{ s.name }}</option>{% endfor %}</select></div>
          </div>
          <div class="row mb-3">
            <label for="input-status-delivered" class="col-sm-3 col-form-label">{{ entry_status_delivered }}</label>
            <div class="col-sm-9"><select name="shipping_rentadriver_status_delivered" id="input-status-delivered" class="form-select"><option value="0">{{ text_keep }}</option>{% for s in order_statuses %}<option value="{{ s.order_status_id }}"{% if s.order_status_id == shipping_rentadriver_status_delivered %} selected{% endif %}>{{ s.name }}</option>{% endfor %}</select><div class="form-text">{{ text_delivered_help }}</div></div>
          </div>
          <div class="row mb-3">
            <label for="input-tax-class" class="col-sm-3 col-form-label">{{ entry_tax_class }}</label>
            <div class="col-sm-9"><select name="shipping_rentadriver_tax_class_id" id="input-tax-class" class="form-select"><option value="0">{{ text_none }}</option>{% for t in tax_classes %}<option value="{{ t.tax_class_id }}"{% if t.tax_class_id == shipping_rentadriver_tax_class_id %} selected{% endif %}>{{ t.title }}</option>{% endfor %}</select></div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-3 col-form-label">{{ entry_test_mode }}</label>
            <div class="col-sm-9"><div class="form-check form-switch form-switch-lg"><input type="hidden" name="shipping_rentadriver_test_mode" value="0"/><input type="checkbox" name="shipping_rentadriver_test_mode" value="1" class="form-check-input"{% if shipping_rentadriver_test_mode %} checked{% endif %}/></div><div class="form-text">{{ text_test_help }}</div></div>
          </div>
          <div class="row mb-3">
            <label for="input-sort-order" class="col-sm-3 col-form-label">{{ entry_sort_order }}</label>
            <div class="col-sm-9"><input type="text" name="shipping_rentadriver_sort_order" value="{{ shipping_rentadriver_sort_order }}" id="input-sort-order" class="form-control"/></div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
