{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-shipping" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }} <small>v{{ version }}</small></h1>
      <ul class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}</ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}<div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}</div>{% endif %}
    {% if success %}<div class="alert alert-success"><i class="fa fa-check-circle"></i> {{ success }}</div>{% endif %}
    <div class="panel panel-default">
      <div class="panel-body">
        {% if connected %}
          <p>{{ text_connected|format(store_key) }} {{ text_managed }}</p>
          <a href="{{ open }}" target="_blank" rel="noopener" class="btn btn-primary">{{ button_open }}</a>
          <a href="{{ setup }}" target="_blank" rel="noopener" class="btn btn-default">{{ button_setup }}</a>
          <a href="{{ disconnect }}" class="btn btn-link">{{ button_disconnect }}</a>
        {% else %}
          <p>{{ text_intro }}</p>
          {% if https %}<a href="{{ connect }}" class="btn btn-primary">{{ button_connect }}</a>{% else %}<div class="alert alert-warning">{{ text_no_https }}</div>{% endif %}
        {% endif %}
      </div>
    </div>
    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3></div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-shipping" class="form-horizontal">
          <div class="form-group">
            <label class="col-sm-3 control-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-9"><select name="shipping_rentadriver_status" id="input-status" class="form-control"><option value="1"{% if shipping_rentadriver_status %} selected{% endif %}>{{ text_enabled }}</option><option value="0"{% if not shipping_rentadriver_status %} selected{% endif %}>{{ text_disabled }}</option></select></div>
          </div>
          <div class="form-group">
            <label class="col-sm-3 control-label" for="input-status-shipped">{{ entry_status_shipped }}</label>
            <div class="col-sm-9"><select name="shipping_rentadriver_status_shipped" id="input-status-shipped" class="form-control"><option value="0">{{ text_keep }}</option>{% for s in order_statuses %}<option value="{{ s.order_status_id }}"{% if s.order_status_id == shipping_rentadriver_status_shipped %} selected{% endif %}>{{ s.name }}</option>{% endfor %}</select></div>
          </div>
          <div class="form-group">
            <label class="col-sm-3 control-label" for="input-status-delivered">{{ entry_status_delivered }}</label>
            <div class="col-sm-9"><select name="shipping_rentadriver_status_delivered" id="input-status-delivered" class="form-control"><option value="0">{{ text_keep }}</option>{% for s in order_statuses %}<option value="{{ s.order_status_id }}"{% if s.order_status_id == shipping_rentadriver_status_delivered %} selected{% endif %}>{{ s.name }}</option>{% endfor %}</select><p class="help-block">{{ text_delivered_help }}</p></div>
          </div>
          <div class="form-group">
            <label class="col-sm-3 control-label" for="input-tax-class">{{ entry_tax_class }}</label>
            <div class="col-sm-9"><select name="shipping_rentadriver_tax_class_id" id="input-tax-class" class="form-control"><option value="0">{{ text_none }}</option>{% for t in tax_classes %}<option value="{{ t.tax_class_id }}"{% if t.tax_class_id == shipping_rentadriver_tax_class_id %} selected{% endif %}>{{ t.title }}</option>{% endfor %}</select></div>
          </div>
          <div class="form-group">
            <label class="col-sm-3 control-label" for="input-test-mode">{{ entry_test_mode }}</label>
            <div class="col-sm-9"><div class="checkbox"><label><input type="checkbox" name="shipping_rentadriver_test_mode" value="1" id="input-test-mode"{% if shipping_rentadriver_test_mode %} checked{% endif %}/></label></div><p class="help-block">{{ text_test_help }}</p></div>
          </div>
          <div class="form-group">
            <label class="col-sm-3 control-label" for="input-sort-order">{{ entry_sort_order }}</label>
            <div class="col-sm-9"><input type="text" name="shipping_rentadriver_sort_order" value="{{ shipping_rentadriver_sort_order }}" id="input-sort-order" class="form-control"/></div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
