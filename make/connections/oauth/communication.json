{
  "authorize": {
    "url": "https://rentadriver.ai/oauth/authorize",
    "temp": {
      "code_verifier": "{{uuid}}{{uuid}}{{uuid}}"
    },
    "qs": {
      "client_id": "{{common.clientId}}",
      "scope": "{{join(oauth.scope, ' ')}}",
      "redirect_uri": "{{oauth.localRedirectUri}}",
      "response_type": "code",
      "code_challenge": "{{replace(replace(replace(sha256(temp.code_verifier, 'base64'), '/\\+/g', '-'), '/\\//g', '_'), '/=+$/', '')}}",
      "code_challenge_method": "S256"
    },
    "response": {
      "temp": {
        "code": "{{query.code}}"
      }
    },
    "log": {
      "sanitize": [
        "response",
        "request.temp.code_verifier"
      ]
    }
  },
  "token": {
    "url": "https://api.rentadriver.ai/oauth/token",
    "method": "POST",
    "type": "urlencoded",
    "body": {
      "grant_type": "authorization_code",
      "client_id": "{{common.clientId}}",
      "code": "{{temp.code}}",
      "code_verifier": "{{temp.code_verifier}}",
      "redirect_uri": "{{oauth.localRedirectUri}}"
    },
    "response": {
      "data": {
        "accessToken": "{{body.access_token}}",
        "refreshToken": "{{body.refresh_token}}",
        "expires": "{{addSeconds(now, body.expires_in)}}",
        "workspaceId": "{{parameters.workspaceId}}"
      }
    },
    "log": {
      "sanitize": [
        "request.body.code",
        "request.body.code_verifier",
        "response.body"
      ]
    }
  },
  "refresh": {
    "condition": "{{data.expires < addMinutes(now, 5)}}",
    "url": "https://api.rentadriver.ai/oauth/token",
    "method": "POST",
    "type": "urlencoded",
    "body": {
      "grant_type": "refresh_token",
      "client_id": "{{common.clientId}}",
      "refresh_token": "{{data.refreshToken}}"
    },
    "response": {
      "data": {
        "accessToken": "{{body.access_token}}",
        "refreshToken": "{{body.refresh_token}}",
        "expires": "{{addSeconds(now, body.expires_in)}}",
        "workspaceId": "{{data.workspaceId}}"
      }
    },
    "log": {
      "sanitize": [
        "request.body.refresh_token",
        "response.body"
      ]
    }
  },
  "info": {
    "url": "https://api.rentadriver.ai/v1/automation/connection",
    "headers": {
      "authorization": "Bearer {{connection.accessToken}}",
      "x-workspace-id": "{{connection.workspaceId}}"
    },
    "response": {
      "metadata": {
        "type": "text",
        "value": "{{body.connection.account_name}} \u00b7 {{body.connection.country_code}} \u00b7 {{body.connection.mode}}"
      },
      "data": {
        "workspaceId": "{{parameters.workspaceId}}"
      }
    },
    "log": {
      "sanitize": [
        "request.headers.authorization",
        "response.body"
      ]
    }
  },
  "invalidate": {
    "url": "https://api.rentadriver.ai/oauth/revoke",
    "method": "POST",
    "type": "urlencoded",
    "body": {
      "token": "{{connection.refreshToken}}"
    },
    "log": {
      "sanitize": [
        "request.body.token"
      ]
    }
  }
}
