<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="sales_order_save_after">
        <observer name="rentadriver_order_changed" instance="RentADriver\Delivery\Observer\OrderSaved"/>
    </event>
    <event name="sales_order_save_commit_after">
        <observer name="rentadriver_order_committed" instance="RentADriver\Delivery\Observer\OrderCommitted"/>
    </event>
</config>
